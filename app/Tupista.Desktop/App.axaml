<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Tupista.Desktop"
             x:Class="Tupista.Desktop.App">

    <Application.Resources>
        <ResourceDictionary>

            <!--
                The palette lives in its own file under Themes/, merged here as
                the first (and only) merged dictionary. PaletteLoader replaces
                this slot at runtime when the setting changes.

                Merging one by default rather than none means the XAML previewer
                and the designer still resolve every colour.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Tupista.Desktop/Themes/InkVermilion.axaml" />
            </ResourceDictionary.MergedDictionaries>


            <local:ThemeVariantConverter x:Key="ThemeConverter" />

            <!--
                Gear icon as pure path data on a 24x24 grid: eight teeth around
                a ring, plus a counter-clockwise inner circle that the nonzero
                fill rule turns into a hole.

                Vector rather than an image file so it stays sharp at any DPI
                and, more usefully here, inherits its colour from whatever brush
                the button hands it — which means it follows the palette and the
                light/dark variant for free.
            -->
            <!-- All icons are 24x24 path data. Vector so they stay sharp at any
                 DPI, and monochrome so a Fill binding lets each one inherit its
                 button's foreground — which means they follow the palette and
                 the light/dark variant without a second copy. -->

            <!-- Play: a triangle. Placement mode. -->
            <StreamGeometry x:Key="PlayIcon">M8,5 L19,12 L8,19 Z</StreamGeometry>

            <!-- Pencil: editing the puzzle itself. -->
            <StreamGeometry x:Key="PencilIcon">M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z</StreamGeometry>

            <!-- Lightbulb: hints. -->
            <StreamGeometry x:Key="HintIcon">M9,21 C9,21.55 9.45,22 10,22 L14,22 C14.55,22 15,21.55 15,21 L15,20 L9,20 L9,21 Z M12,2 C8.14,2 5,5.14 5,9 C5,11.38 6.19,13.47 8,14.74 L8,17 C8,17.55 8.45,18 9,18 L15,18 C15.55,18 16,17.55 16,17 L16,14.74 C17.81,13.47 19,11.38 19,9 C19,5.14 15.86,2 12,2 Z</StreamGeometry>

            <!-- Magnifier: how many solutions are there? Not a tick — this
                 answers "how many", not "is it valid". -->
            <StreamGeometry x:Key="SearchIcon">M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z</StreamGeometry>

            <!-- Filled grid: solve the whole thing. -->
            <StreamGeometry x:Key="SolveIcon">M3,3 L3,21 L21,21 L21,3 L3,3 Z M9,19 L5,19 L5,15 L9,15 L9,19 Z M9,13 L5,13 L5,9 L9,9 L9,13 Z M9,7 L5,7 L5,5 L9,5 L9,7 Z M15,19 L11,19 L11,15 L15,15 L15,19 Z M15,13 L11,13 L11,9 L15,9 L15,13 Z M15,7 L11,7 L11,5 L15,5 L15,7 Z M19,19 L17,19 L17,15 L19,15 L19,19 Z M19,13 L17,13 L17,9 L19,9 L19,13 Z M19,7 L17,7 L17,5 L19,5 L19,7 Z</StreamGeometry>

            <!-- Checklist: audit the player's pencil marks. -->
            <StreamGeometry x:Key="AuditIcon">M19,3 L14.82,3 C14.4,1.84 13.3,1 12,1 C10.7,1 9.6,1.84 9.18,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M12,2.75 C12.41,2.75 12.75,3.09 12.75,3.5 C12.75,3.91 12.41,4.25 12,4.25 C11.59,4.25 11.25,3.91 11.25,3.5 C11.25,3.09 11.59,2.75 12,2.75 Z M10,17 L6,13 L7.41,11.59 L10,14.17 L16.59,7.58 L18,9 L10,17 Z</StreamGeometry>

            <!-- Floppy disk: the standard save glyph. Body with the cut corner,
                 the shutter across the top, and the spindle hole. -->
            <StreamGeometry x:Key="SaveIcon">M17,3 L5,3 C3.89,3 3,3.9 3,5 L3,19 C3,20.1 3.89,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,7 L17,3 Z M12,19 C10.34,19 9,17.66 9,16 C9,14.34 10.34,13 12,13 C13.66,13 15,14.34 15,16 C15,17.66 13.66,19 12,19 Z M15,9 L5,9 L5,5 L15,5 L15,9 Z</StreamGeometry>

            <!-- Plus in a square: a fresh puzzle. -->
            <StreamGeometry x:Key="NewIcon">M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M17,13 L13,13 L13,17 L11,17 L11,13 L7,13 L7,11 L11,11 L11,7 L13,7 L13,11 L17,11 L17,13 Z</StreamGeometry>

            <!-- Counter-clockwise arrow: Clear returns to the starting
                 position. A bin would say "destroy", which is the wrong idea. -->
            <StreamGeometry x:Key="ResetIcon">M12,5 L12,1 L7,6 L12,11 L12,7 C15.31,7 18,9.69 18,13 C18,16.31 15.31,19 12,19 C8.69,19 6,16.31 6,13 L4,13 C4,17.42 7.58,21 12,21 C16.42,21 20,17.42 20,13 C20,8.58 16.42,5 12,5 Z</StreamGeometry>

            <!-- Folder opening: load a saved puzzle. -->
            <StreamGeometry x:Key="LoadIcon">M20,6 L12,6 L10,4 L4,4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z</StreamGeometry>

            <!-- Bin: deleting a saved puzzle really is destructive, so it keeps
                 its label as well as the icon. -->
            <StreamGeometry x:Key="DeleteIcon">M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 L6,19 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 Z</StreamGeometry>

            <StreamGeometry x:Key="GearIcon">M13.4,2 L10.6,2 C10.3,2 10.1,2.2 10.05,2.5 L9.7,4.6 C9.1,4.8 8.5,5.1 8,5.5 L6,4.7 C5.7,4.6 5.4,4.7 5.25,5 L3.85,7.4 C3.7,7.66 3.77,7.98 4,8.16 L5.7,9.45 C5.65,9.8 5.62,10.15 5.62,10.5 C5.62,10.85 5.65,11.2 5.7,11.55 L4,12.84 C3.77,13.02 3.7,13.34 3.85,13.6 L5.25,16 C5.4,16.3 5.7,16.4 6,16.3 L8,15.5 C8.5,15.9 9.1,16.2 9.7,16.4 L10.05,18.5 C10.1,18.8 10.3,19 10.6,19 L13.4,19 C13.7,19 13.9,18.8 13.95,18.5 L14.3,16.4 C14.9,16.2 15.5,15.9 16,15.5 L18,16.3 C18.3,16.4 18.6,16.3 18.75,16 L20.15,13.6 C20.3,13.34 20.23,13.02 20,12.84 L18.3,11.55 C18.35,11.2 18.38,10.85 18.38,10.5 C18.38,10.15 18.35,9.8 18.3,9.45 L20,8.16 C20.23,7.98 20.3,7.66 20.15,7.4 L18.75,5 C18.6,4.7 18.3,4.6 18,4.7 L16,5.5 C15.5,5.1 14.9,4.8 14.3,4.6 L13.95,2.5 C13.9,2.2 13.7,2 13.4,2 Z M12,7.4 C13.71,7.4 15.1,8.79 15.1,10.5 C15.1,12.21 13.71,13.6 12,13.6 C10.29,13.6 8.9,12.21 8.9,10.5 C8.9,8.79 10.29,7.4 12,7.4 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ============================ buttons ============================ -->
        <!--
            Corner radius, generous padding and a visible hover state are what
            separate "a button" from "a rectangle with a word in it". Defined
            once here so every screen inherits the same feel.
        -->
        <!-- Icons sit inside buttons at a fixed size and inherit the button's
             own foreground, so they recolour with the palette and with the
             primary/secondary distinction for free. -->
        <Style Selector="Path.btnIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.btnIcon.chipIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- /template/ reaches inside the control's own template. Fluent paints
             its background on the inner ContentPresenter, so setting it on the
             Button alone is silently ignored on hover. -->
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        </Style>
        <Style Selector="Button.action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBorderBrush}" />
        </Style>

        <!-- The one button per group that carries the main intent. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <!-- Small pill buttons for the saved-puzzle rows. -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
        </Style>

        <!-- ============================ the grid ============================ -->
        <Style Selector="Button.cell">
            <Setter Property="Background" Value="{DynamicResource CellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="58" />
        </Style>
        <Style Selector="Button.cell /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CellBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.cell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CellHoverBrush}" />
        </Style>

        <!-- Cells take focus so the board's KeyBindings activate, but Avalonia's
             default focus ring on top of our own selection outline looks like a
             rendering fault. FocusAdorner is the right way to remove it.

             Do NOT do this by zeroing BorderThickness on :focus: Fluent draws
             the button's border on the inner ContentPresenter, so that erases
             the selection outline on the very cell you just clicked, and it
             only reappears once focus moves on â€” a selection that lags one
             click behind. -->
        <Style Selector="Button.cell">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Order matters: later rules win, so a conflict shows through a hint
             highlight, and the selection outline sits on top of everything. -->
        <Style Selector="Button.cell.eliminated /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource EliminatedBrush}" />
        </Style>
        <Style Selector="Button.cell.pattern /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PatternBrush}" />
        </Style>
        <Style Selector="Button.cell.placement /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PlacementBrush}" />
        </Style>
        <Style Selector="Button.cell.conflict /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ConflictBrush}" />
        </Style>
        <!-- SelectionBrush, not AccentBrush: the selection outline is drawn on
             the board, and in the red palettes the accent means "illegal" in
             there. Keeping them separate is what stops red meaning two things. -->
        <Style Selector="Button.cell.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>

        <Style Selector="TextBlock.digit">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource UserTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.digit.given">
            <Setter Property="Foreground" Value="{DynamicResource GivenTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Small digits inside a cell. Engine candidates are muted; the
             player's own marks are stronger and take the "your work" colour,
             so notes are never mistaken for the engine's opinion. -->
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource CandidateTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.note.userMark">
            <Setter Property="Foreground" Value="{DynamicResource UserTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.candidates">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource CandidateTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============================ chrome ============================= -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="TextBox.name">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Application.Styles>

</Application>
