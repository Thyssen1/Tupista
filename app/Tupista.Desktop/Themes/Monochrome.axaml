<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        "Monochrome" — greys throughout, red as the only colour in the chrome.

        Because nothing else competes, the hint highlights (green, amber,
        violet) carry far more weight here than in the other palettes. That is
        the point: the board is the only thing with colour in it.

        This one leans hardest on the accent-stays-out-of-the-grid rule, so the
        selection outline is a pure neutral.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceBrush"        Color="#F2F2F2" />
            <SolidColorBrush x:Key="PanelBrush"          Color="#FFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush"    Color="#E0E0E0" />
            <SolidColorBrush x:Key="CellBrush"           Color="#FFFFFF" />
            <SolidColorBrush x:Key="CellBorderBrush"     Color="#DBDBDB" />
            <SolidColorBrush x:Key="CellHoverBrush"      Color="#EFEFEF" />
            <SolidColorBrush x:Key="GridLineBrush"       Color="#1F1F1F" />
            <SolidColorBrush x:Key="GivenTextBrush"      Color="#111111" />
            <SolidColorBrush x:Key="UserTextBrush"       Color="#5A5A5A" />
            <SolidColorBrush x:Key="SubtleTextBrush"     Color="#6E6E6E" />
            <SolidColorBrush x:Key="CandidateTextBrush"  Color="#A0A0A0" />
            <SolidColorBrush x:Key="AccentBrush"         Color="#C2261C" />
            <SolidColorBrush x:Key="AccentHoverBrush"    Color="#9E1E16" />
            <SolidColorBrush x:Key="AccentTextBrush"     Color="#FFFFFF" />
            <SolidColorBrush x:Key="SelectionBrush"      Color="#1F1F1F" />
            <SolidColorBrush x:Key="ButtonBrush"         Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonHoverBrush"    Color="#ECECEC" />
            <SolidColorBrush x:Key="ButtonBorderBrush"   Color="#D2D2D2" />
            <SolidColorBrush x:Key="ConflictBrush"       Color="#FBD5D2" />
            <SolidColorBrush x:Key="PlacementBrush"      Color="#C9EBD4" />
            <SolidColorBrush x:Key="PatternBrush"        Color="#FBEDC0" />
            <SolidColorBrush x:Key="EliminatedBrush"     Color="#E6E1F8" />
            <SolidColorBrush x:Key="HintPanelBrush"      Color="#F7F7F7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceBrush"        Color="#121212" />
            <SolidColorBrush x:Key="PanelBrush"          Color="#1C1C1C" />
            <SolidColorBrush x:Key="PanelBorderBrush"    Color="#2C2C2C" />
            <SolidColorBrush x:Key="CellBrush"           Color="#212121" />
            <SolidColorBrush x:Key="CellBorderBrush"     Color="#343434" />
            <SolidColorBrush x:Key="CellHoverBrush"      Color="#2C2C2C" />
            <SolidColorBrush x:Key="GridLineBrush"       Color="#A8A8A8" />
            <SolidColorBrush x:Key="GivenTextBrush"      Color="#F2F2F2" />
            <SolidColorBrush x:Key="UserTextBrush"       Color="#B0B0B0" />
            <SolidColorBrush x:Key="SubtleTextBrush"     Color="#9A9A9A" />
            <SolidColorBrush x:Key="CandidateTextBrush"  Color="#6E6E6E" />
            <SolidColorBrush x:Key="AccentBrush"         Color="#E4483C" />
            <SolidColorBrush x:Key="AccentHoverBrush"    Color="#F0655A" />
            <SolidColorBrush x:Key="AccentTextBrush"     Color="#120A09" />
            <SolidColorBrush x:Key="SelectionBrush"      Color="#E8E8E8" />
            <SolidColorBrush x:Key="ButtonBrush"         Color="#262626" />
            <SolidColorBrush x:Key="ButtonHoverBrush"    Color="#313131" />
            <SolidColorBrush x:Key="ButtonBorderBrush"   Color="#3C3C3C" />
            <SolidColorBrush x:Key="ConflictBrush"       Color="#552624" />
            <SolidColorBrush x:Key="PlacementBrush"      Color="#22452E" />
            <SolidColorBrush x:Key="PatternBrush"        Color="#463C1E" />
            <SolidColorBrush x:Key="EliminatedBrush"     Color="#332C48" />
            <SolidColorBrush x:Key="HintPanelBrush"      Color="#1A1A1A" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
