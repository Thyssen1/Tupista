<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tupista.ViewModels"
        xmlns:storage="using:Tupista.Storage"
        x:Class="Tupista.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Tupista" Width="1040" Height="760"
        MinWidth="960" MinHeight="680"
        Background="{DynamicResource SurfaceBrush}"
        RequestedThemeVariant="{Binding Theme, Converter={StaticResource ThemeConverter}}">

    <!--
        Theme switching with no code-behind: the window's own theme variant is
        bound to the view model, and every colour in the app comes from a
        DynamicResource that resolves per variant. Changing the setting
        repaints the whole tree.

        Keyboard input is bindings too. A keystroke invokes a command exactly
        like a button click, which is what keeps MainWindow.axaml.cs empty.
        The bindings live on the BOARD, not on the window — see below.
    -->

    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- ============================== header ============================== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center">
                <TextBlock Text="Tupista" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource GivenTextBrush}" />
                <TextBlock Text="your hint" FontSize="13" VerticalAlignment="Bottom"
                           Margin="0,0,0,4"
                           Foreground="{DynamicResource SubtleTextBrush}" />
            </StackPanel>

            <!-- Settings lives in a Flyout: a popup declared inline, opened by
                 its button with no handler and no second window to manage. -->
            <Button Grid.Column="1" Classes="action" HorizontalAlignment="Right"
                    Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Stretch=Uniform keeps the gear round whatever size the
                         box is; the Fill binding makes it inherit the button's
                         own foreground, so it follows the palette. -->
                    <Path Data="{StaticResource GearIcon}"
                          Fill="{Binding $parent[Button].Foreground}"
                          Width="15" Height="15" Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="230" Spacing="10" Margin="4">
                            <TextBlock Text="SETTINGS" Classes="sectionHeader" Margin="0" />

                            <TextBlock Text="Colour scheme" FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                            <ComboBox ItemsSource="{Binding PaletteOptions}"
                                      SelectedItem="{Binding Palette}"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="10" />

                            <TextBlock Text="Light / dark" FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme}"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="10" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Every scheme has a light and a dark version, so the two settings combine. System follows your operating system. Both are remembered." />

                            <Separator Margin="0,4" />

                            <CheckBox IsChecked="{Binding ShowCandidates}"
                                      Content="Show candidates in empty cells" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- =============================== body =============================== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <Border Grid.Column="0" Classes="card" VerticalAlignment="Top"
                    HorizontalAlignment="Left" Padding="18">
                <!--
                    The keyboard bindings live HERE rather than on the Window.

                    On the Window they fired no matter what had focus, so typing
                    a digit into the puzzle-name box also dropped that digit
                    onto the board. Avalonia evaluates KeyBindings on the
                    focused element and then up its ancestors, so attaching them
                    to the board means they only fire while focus is inside the
                    board — the name box is not a descendant, so it keeps its
                    own keystrokes.
                -->
                <Border BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="2"
                        CornerRadius="4" ClipToBounds="True" Focusable="True">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Up"    Command="{Binding MoveCommand}" CommandParameter="up" />
                        <KeyBinding Gesture="Down"  Command="{Binding MoveCommand}" CommandParameter="down" />
                        <KeyBinding Gesture="Left"  Command="{Binding MoveCommand}" CommandParameter="left" />
                        <KeyBinding Gesture="Right" Command="{Binding MoveCommand}" CommandParameter="right" />

                        <KeyBinding Gesture="D1" Command="{Binding EnterDigitCommand}" CommandParameter="1" />
                        <KeyBinding Gesture="D2" Command="{Binding EnterDigitCommand}" CommandParameter="2" />
                        <KeyBinding Gesture="D3" Command="{Binding EnterDigitCommand}" CommandParameter="3" />
                        <KeyBinding Gesture="D4" Command="{Binding EnterDigitCommand}" CommandParameter="4" />
                        <KeyBinding Gesture="D5" Command="{Binding EnterDigitCommand}" CommandParameter="5" />
                        <KeyBinding Gesture="D6" Command="{Binding EnterDigitCommand}" CommandParameter="6" />
                        <KeyBinding Gesture="D7" Command="{Binding EnterDigitCommand}" CommandParameter="7" />
                        <KeyBinding Gesture="D8" Command="{Binding EnterDigitCommand}" CommandParameter="8" />
                        <KeyBinding Gesture="D9" Command="{Binding EnterDigitCommand}" CommandParameter="9" />

                        <KeyBinding Gesture="NumPad1" Command="{Binding EnterDigitCommand}" CommandParameter="1" />
                        <KeyBinding Gesture="NumPad2" Command="{Binding EnterDigitCommand}" CommandParameter="2" />
                        <KeyBinding Gesture="NumPad3" Command="{Binding EnterDigitCommand}" CommandParameter="3" />
                        <KeyBinding Gesture="NumPad4" Command="{Binding EnterDigitCommand}" CommandParameter="4" />
                        <KeyBinding Gesture="NumPad5" Command="{Binding EnterDigitCommand}" CommandParameter="5" />
                        <KeyBinding Gesture="NumPad6" Command="{Binding EnterDigitCommand}" CommandParameter="6" />
                        <KeyBinding Gesture="NumPad7" Command="{Binding EnterDigitCommand}" CommandParameter="7" />
                        <KeyBinding Gesture="NumPad8" Command="{Binding EnterDigitCommand}" CommandParameter="8" />
                        <KeyBinding Gesture="NumPad9" Command="{Binding EnterDigitCommand}" CommandParameter="9" />

                        <KeyBinding Gesture="D0"     Command="{Binding EnterDigitCommand}" CommandParameter="0" />
                        <KeyBinding Gesture="Delete" Command="{Binding EnterDigitCommand}" CommandParameter="0" />
                        <KeyBinding Gesture="Back"   Command="{Binding EnterDigitCommand}" CommandParameter="0" />

                        <!-- Escape wipes the cell entirely: digit and pencil
                             marks. Delete only clears the digit. -->
                        <KeyBinding Gesture="Escape" Command="{Binding ResetCellCommand}" />

                        <!-- Shift+digit notes without switching modes. -->
                        <KeyBinding Gesture="Shift+D1" Command="{Binding NoteDigitCommand}" CommandParameter="1" />
                        <KeyBinding Gesture="Shift+D2" Command="{Binding NoteDigitCommand}" CommandParameter="2" />
                        <KeyBinding Gesture="Shift+D3" Command="{Binding NoteDigitCommand}" CommandParameter="3" />
                        <KeyBinding Gesture="Shift+D4" Command="{Binding NoteDigitCommand}" CommandParameter="4" />
                        <KeyBinding Gesture="Shift+D5" Command="{Binding NoteDigitCommand}" CommandParameter="5" />
                        <KeyBinding Gesture="Shift+D6" Command="{Binding NoteDigitCommand}" CommandParameter="6" />
                        <KeyBinding Gesture="Shift+D7" Command="{Binding NoteDigitCommand}" CommandParameter="7" />
                        <KeyBinding Gesture="Shift+D8" Command="{Binding NoteDigitCommand}" CommandParameter="8" />
                        <KeyBinding Gesture="Shift+D9" Command="{Binding NoteDigitCommand}" CommandParameter="9" />
                    </Border.KeyBindings>
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="9" Columns="9" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CellViewModel">
                                    <!-- A Button because clicking a cell must raise
                                         a command, and that is what a Button does.
                                         $parent[ItemsControl] reaches past the cell
                                         to the window's DataContext, where the
                                         command lives. -->
                                    <!-- Focusable so that clicking a cell moves focus
                                         INTO the board, which is what activates the
                                         board's KeyBindings above. Arrow keys do not
                                         wander between cells because those bindings
                                         consume them first.

                                         IsTabStop=False keeps Tab from walking
                                         through all 81 of them. -->
                                    <Button Classes="cell"
                                            IsTabStop="False"
                                            Classes.selected="{Binding IsSelected}"
                                            Classes.conflict="{Binding IsConflicted}"
                                            Classes.placement="{Binding IsHintPlacement}"
                                            Classes.pattern="{Binding IsHintPattern}"
                                            Classes.eliminated="{Binding IsHintEliminated}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <TextBlock Classes="digit"
                                                       Classes.given="{Binding IsGiven}"
                                                       Text="{Binding Display}" />

                                            <!-- The notes grid. Nine fixed slots,
                                                 shown or hidden individually, so a
                                                 digit never moves as marks change:
                                                 5 is always dead centre. -->
                                            <ItemsControl ItemsSource="{Binding Notes}"
                                                          IsVisible="{Binding HasNotes}"
                                                          Margin="4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="3" Columns="3" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CellNote">
                                                        <TextBlock Classes="note"
                                                                   Classes.userMark="{Binding IsUserMark}"
                                                                   Text="{Binding Text}"
                                                                   IsVisible="{Binding Shown}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The 3x3 separators, drawn over the cells. Without them
                             every boundary looks the same and the boxes vanish. -->
                        <Grid IsHitTestVisible="False">
                            <Rectangle Fill="{DynamicResource GridLineBrush}" Width="2" Height="522"
                                       HorizontalAlignment="Left" Margin="173,0,0,0" />
                            <Rectangle Fill="{DynamicResource GridLineBrush}" Width="2" Height="522"
                                       HorizontalAlignment="Left" Margin="347,0,0,0" />
                            <Rectangle Fill="{DynamicResource GridLineBrush}" Height="2" Width="522"
                                       VerticalAlignment="Top" Margin="0,173,0,0" />
                            <Rectangle Fill="{DynamicResource GridLineBrush}" Height="2" Width="522"
                                       VerticalAlignment="Top" Margin="0,347,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- ============================ side panel ============================ -->
            <ScrollViewer Grid.Column="1" Margin="20,0,0,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="0">

                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PUZZLE" Classes="sectionHeader" Margin="2,0,0,2" />
                            <TextBox Classes="name" Text="{Binding BoardName}"
                                     Watermark="Name this puzzle" />
                            <!-- The icon follows the label: a play triangle while
                                 you are still typing the puzzle in, a pencil once
                                 you are playing and the button offers to go back. -->
                            <Button Classes="action" Command="{Binding TogglePlayCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource PlayIcon}"
                                          Fill="{Binding $parent[Button].Foreground}"
                                          IsVisible="{Binding IsEditingGivens}" />
                                    <Path Classes="btnIcon" Data="{StaticResource PencilIcon}"
                                          Fill="{Binding $parent[Button].Foreground}"
                                          IsVisible="{Binding !IsEditingGivens}" />
                                    <TextBlock Text="{Binding ModeLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="action" Command="{Binding TogglePencilCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource PencilIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="{Binding PencilLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Shift+digit notes without leaving placement mode." />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ASK THE ENGINE" Classes="sectionHeader"
                                       Margin="2,0,0,2" />
                            <Button Classes="action primary" Command="{Binding HintCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource HintIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Hint" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action" Command="{Binding CheckCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource SearchIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Is there a solution?" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action" Command="{Binding SolveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource SolveIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Solve it" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="action" Command="{Binding AuditMarksCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource AuditIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Check my pencil marks" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Completion announces itself; there is nothing to press.
                         PlacementBrush is the "this is the answer" colour in
                         every palette, so success looks the same here as it
                         does on the board. -->
                    <Border Classes="card" Margin="0,12,0,0"
                            IsVisible="{Binding IsSolved}"
                            Background="{DynamicResource PlacementBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="COMPLETE" Classes="sectionHeader" Margin="0"
                                       Foreground="{DynamicResource GivenTextBrush}" />
                            <TextBlock Text="{Binding CompletionMessage}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" LineHeight="19"
                                       Foreground="{DynamicResource GivenTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,12,0,0"
                            IsVisible="{Binding !!HintText.Length}"
                            Background="{DynamicResource HintPanelBrush}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="HINT" Classes="sectionHeader" Margin="0" />
                            <TextBlock Text="{Binding HintText}" TextWrapping="Wrap"
                                       LineHeight="19" />
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,12,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="BOARD" Classes="sectionHeader" Margin="2,0,0,2" />
                            <Button Classes="action primary" Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Classes="btnIcon" Data="{StaticResource SaveIcon}"
                                          Fill="{Binding $parent[Button].Foreground}" />
                                    <TextBlock Text="Save" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Classes="action"
                                        Command="{Binding NewCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="btnIcon" Data="{StaticResource NewIcon}"
                                              Fill="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="New" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="action"
                                        Command="{Binding ClearCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Classes="btnIcon" Data="{StaticResource ResetIcon}"
                                              Fill="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                               LineHeight="18" Margin="4,14,4,0"
                               Foreground="{DynamicResource SubtleTextBrush}" />

                    <Border Classes="card" Margin="0,14,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="SAVED PUZZLES" Classes="sectionHeader" Margin="0" />
                            <ListBox ItemsSource="{Binding SavedBoards}" MaxHeight="230"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="storage:SavedBoard">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           Text="{Binding FilledCount, StringFormat='{}{0} digits placed'}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="chip" Margin="6,0"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).LoadCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="btnIcon chipIcon"
                                                          Data="{StaticResource LoadIcon}"
                                                          Fill="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Load" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <!-- Delete keeps its label. An icon-only
                                                 destructive control is how people
                                                 remove the wrong thing. -->
                                            <Button Grid.Column="2" Classes="chip"
                                                    Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="btnIcon chipIcon"
                                                          Data="{StaticResource DeleteIcon}"
                                                          Fill="{Binding $parent[Button].Foreground}" />
                                                    <TextBlock Text="Delete" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
